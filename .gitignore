

# --- Node.js dependencies ---
node_modules/

# --- Log files ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# --- Process & runtime data ---
pids/
*.pid
*.pid.lock

# --- Environment variables ---
# .env.example은 버전관리 대상으로 남겨둠 (gitignore는 인라인 주석을 지원하지 않으므로 별도 줄로 분리)
.env
.env.*
!.env.example

# --- Build outputs & coverage ---
dist/
build/
coverage/
.nyc_output/

# --- Temporary files ---
tmp/
debug/

# --- OS generated files ---
.DS_Store

# --- IDE/editor folders ---
.vscode/
.idea/
*.sw?

# --- Optional lock files (keep the one you use) ---
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Local database & state ---
data.db
data.db-journal
data.db-wal
data.db-shm
snapshots.json