# Google Gemini API 키 (필수 권장) — 미설정 시 /api/chat이 데모 응답 모드로 동작
GEMINI_API_KEY=

# 서버 포트 (선택, 기본값 4000)
PORT=4000

# 브라우저 기반 클라이언트(Swagger UI, expo web 등)에 대한 CORS 허용 origin 목록
# 쉼표로 구분. 모바일 앱(Expo/React Native)의 네이티브 fetch는 이 설정과 무관하게 항상 허용됨
# 미설정 시 index.js의 기본값(localhost:19006, localhost:8081, 배포 도메인) 사용
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
